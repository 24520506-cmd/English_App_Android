<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/app_night_bg">
    <com.example.english_app.StarfieldView android:layout_width="match_parent" android:layout_height="match_parent" />
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="24dp" android:paddingBottom="96dp" android:id="@+id/entranceColumn">
            <TextView android:id="@+id/backLink" android:layout_width="wrap_content" android:layout_height="48dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="16dp" android:text="← Quay lại" android:textSize="14sp" android:textColor="@color/pr_mint" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Hoạt động học tập" android:textSize="18sp" android:textColor="@color/pr_white" android:layout_marginTop="12dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NHẬT KÝ HOẠT ĐỘNG" android:textSize="26sp" android:textColor="@color/pr_yellow" android:layout_marginTop="4dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bản đồ học tập minh họa" android:textSize="13sp" android:textColor="@color/pr_muted" android:layout_marginTop="7dp" android:lineSpacingExtra="3dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginTop="10dp" android:background="@drawable/pr_card_bg">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bản đồ hoạt động mẫu (5 tuần)" android:textSize="15sp" android:textColor="@color/pr_white" android:layout_marginTop="0dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Các ô màu là dữ liệu minh họa; chưa có nhật ký theo ngày." android:textSize="13sp" android:textColor="@color/pr_muted" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" />
                <com.example.english_app.ProgressHeatmapView android:layout_width="match_parent" android:layout_height="154dp" android:layout_marginTop="12dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginTop="10dp" android:background="@drawable/pr_card_bg">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mục tiêu streak" android:textSize="15sp" android:textColor="@color/pr_white" android:layout_marginTop="0dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Chuỗi ngày học sẽ hiện khi có nhật ký hoạt động." android:textSize="13sp" android:textColor="@color/pr_muted" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginTop="10dp" android:background="@drawable/pr_card_bg">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Điểm học tập" android:textSize="15sp" android:textColor="@color/pr_white" android:layout_marginTop="0dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Điểm học tập chưa được tính trong bản giao diện này." android:textSize="13sp" android:textColor="@color/pr_muted" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" />
            </LinearLayout>
            <Button android:id="@+id/goProgress" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:background="@drawable/pr_button_bg" android:backgroundTint="@null" android:text="Quay lại tiến độ →" android:textAllCaps="false" android:textStyle="bold" android:textColor="@color/pr_bg" android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:id="@+id/bottomNav" android:layout_width="match_parent" android:layout_height="58dp" android:layout_gravity="bottom" android:orientation="horizontal" android:background="@drawable/pr_tab_bg" android:padding="5dp">
        <Button android:id="@+id/nav0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Học" android:textAllCaps="false" android:textSize="11sp" android:textColor="@color/pr_white" android:backgroundTint="@color/pr_bg" />
        <Button android:id="@+id/nav1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Ôn tập" android:textAllCaps="false" android:textSize="11sp" android:textColor="@color/pr_white" android:backgroundTint="@color/pr_bg" />
        <Button android:id="@+id/nav2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Tiến độ" android:textAllCaps="false" android:textSize="11sp" android:textColor="@color/pr_white" android:backgroundTint="@color/pr_bg" />
        <Button android:id="@+id/nav3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Xếp hạng" android:textAllCaps="false" android:textSize="11sp" android:textColor="@color/pr_white" android:backgroundTint="@color/pr_bg" />
        <Button android:id="@+id/nav4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Hồ sơ" android:textAllCaps="false" android:textSize="11sp" android:textColor="@color/pr_white" android:backgroundTint="@color/pr_bg" />
    </LinearLayout>
</FrameLayout>