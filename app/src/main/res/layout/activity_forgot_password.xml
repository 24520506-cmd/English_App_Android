<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:fillViewport="true" android:clipToPadding="false" android:background="@drawable/app_night_bg">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
  android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp"
  android:paddingTop="34dp" android:paddingBottom="40dp">
  <TextView android:id="@+id/forgotBack" android:layout_width="wrap_content" android:layout_height="48dp"
   android:gravity="center_vertical" android:text="← Quay lại" android:textColor="@color/forgot_mint"
   android:textSize="15sp" android:clickable="true" android:focusable="true" />
  <TextView android:id="@+id/forgotTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:layout_marginTop="28dp" android:text="Khôi phục mật khẩu" android:textStyle="bold"
   android:textColor="@color/forgot_white" android:textSize="21sp" />
  <TextView android:id="@+id/forgotSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:layout_marginTop="8dp" android:text="Nhận mã qua Gmail" android:textStyle="bold"
   android:textColor="@color/forgot_yellow" android:textSize="26sp" />
  <TextView android:id="@+id/forgotDescription" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:layout_marginTop="8dp" android:text="Mã khôi phục sẽ được gửi đến Gmail đã đăng ký."
   android:textColor="@color/forgot_secondary" android:textSize="14sp" />

  <LinearLayout android:id="@+id/forgotStartSection" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="24dp">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="Tên đăng nhập" android:textStyle="bold" android:textSize="14sp"
    android:textColor="@color/forgot_white" />
   <EditText android:id="@+id/forgotUsername" android:layout_width="match_parent" android:layout_height="56dp"
    android:layout_marginTop="8dp" android:background="@drawable/forgot_bg_input"
    android:paddingHorizontal="16dp" android:textColor="@color/forgot_white"
    android:textColorHint="@color/forgot_secondary" android:textSize="15sp"
    android:singleLine="true" android:inputType="text" android:hint="Nhập tên đăng nhập" />
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="18dp" android:text="Gmail đã đăng ký" android:textStyle="bold"
    android:textSize="14sp" android:textColor="@color/forgot_white" />
   <EditText android:id="@+id/forgotEmail" android:layout_width="match_parent" android:layout_height="56dp"
    android:layout_marginTop="8dp" android:background="@drawable/forgot_bg_input"
    android:paddingHorizontal="16dp" android:textColor="@color/forgot_white"
    android:textColorHint="@color/forgot_secondary" android:textSize="15sp"
    android:singleLine="true" android:inputType="textEmailAddress" android:hint="name@example.com" />
   <Button android:id="@+id/forgotSend" android:layout_width="match_parent" android:layout_height="56dp"
    android:layout_marginTop="22dp" android:background="@drawable/forgot_bg_button"
    android:backgroundTint="@null" android:text="Gửi mã Gmail  →" android:textAllCaps="false"
    android:textColor="@color/forgot_bg" android:textStyle="bold" android:textSize="16sp" />
  </LinearLayout>

  <LinearLayout android:id="@+id/forgotOtpSection" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="24dp"
   android:visibility="gone">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="Mã OTP gồm 6 chữ số" android:textStyle="bold" android:textSize="14sp"
    android:textColor="@color/forgot_white" />
   <EditText android:id="@+id/forgotOtp" android:layout_width="match_parent" android:layout_height="56dp"
    android:layout_marginTop="8dp" android:background="@drawable/forgot_bg_input"
    android:paddingHorizontal="16dp" android:textColor="@color/forgot_white"
    android:textColorHint="@color/forgot_secondary" android:textSize="18sp"
    android:singleLine="true" android:maxLength="6" android:inputType="numberPassword"
    android:hint="••••••" />
   <Button android:id="@+id/forgotVerify" android:layout_width="match_parent" android:layout_height="54dp"
    android:layout_marginTop="16dp" android:background="@drawable/forgot_bg_button"
    android:backgroundTint="@null" android:text="Xác minh mã  →" android:textAllCaps="false"
    android:textColor="@color/forgot_bg" android:textStyle="bold" android:textSize="15sp" />
   <Button android:id="@+id/forgotContinue" android:layout_width="match_parent" android:layout_height="54dp"
    android:layout_marginTop="16dp" android:background="@drawable/forgot_bg_button"
    android:backgroundTint="@null" android:text="Tiếp tục  →" android:textAllCaps="false"
    android:textColor="@color/forgot_bg" android:textStyle="bold" android:textSize="15sp"
    android:visibility="gone" />
   <Button android:id="@+id/forgotResend" android:layout_width="match_parent" android:layout_height="48dp"
    android:layout_marginTop="8dp" android:background="@drawable/forgot_bg_input"
    android:backgroundTint="@null" android:text="Gửi lại mã" android:textAllCaps="false"
    android:textColor="@color/forgot_mint" android:textSize="14sp" />
  </LinearLayout>

  <LinearLayout android:id="@+id/forgotResetSection" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="24dp"
   android:visibility="gone">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="Mật khẩu mới" android:textStyle="bold" android:textSize="14sp"
    android:textColor="@color/forgot_white" />
   <EditText android:id="@+id/forgotNewPassword" android:layout_width="match_parent" android:layout_height="56dp"
    android:layout_marginTop="8dp" android:background="@drawable/forgot_bg_input"
    android:paddingHorizontal="16dp" android:textColor="@color/forgot_white"
    android:textColorHint="@color/forgot_secondary" android:textSize="15sp"
    android:singleLine="true" android:inputType="textPassword" android:hint="Tối thiểu 8 ký tự" />
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="18dp" android:text="Nhập lại mật khẩu mới" android:textStyle="bold"
    android:textSize="14sp" android:textColor="@color/forgot_white" />
   <EditText android:id="@+id/forgotConfirmPassword" android:layout_width="match_parent" android:layout_height="56dp"
    android:layout_marginTop="8dp" android:background="@drawable/forgot_bg_input"
    android:paddingHorizontal="16dp" android:textColor="@color/forgot_white"
    android:textColorHint="@color/forgot_secondary" android:textSize="15sp"
    android:singleLine="true" android:inputType="textPassword" android:hint="Nhập lại mật khẩu" />
   <Button android:id="@+id/forgotComplete" android:layout_width="match_parent" android:layout_height="56dp"
    android:layout_marginTop="22dp" android:background="@drawable/forgot_bg_button"
    android:backgroundTint="@null" android:text="Đặt lại mật khẩu  →" android:textAllCaps="false"
    android:textColor="@color/forgot_bg" android:textStyle="bold" android:textSize="16sp" />
  </LinearLayout>

  <TextView android:id="@+id/forgotStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:layout_marginTop="14dp" android:textColor="@color/forgot_yellow" android:textSize="14sp"
   android:visibility="gone" />
 </LinearLayout>
</ScrollView>
