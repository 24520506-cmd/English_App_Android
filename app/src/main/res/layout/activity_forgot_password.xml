<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:fillViewport="true" android:clipToPadding="false" android:background="@drawable/app_night_bg">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
  android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp"
  android:paddingTop="34dp" android:paddingBottom="40dp">
  <TextView android:id="@+id/forgotBack" android:layout_width="wrap_content" android:layout_height="48dp"
   android:gravity="center_vertical" android:text="← Quay lại" android:textColor="@color/forgot_mint"
   android:textSize="15sp" android:clickable="true" android:focusable="true"/>
  <TextView android:id="@+id/forgotTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:layout_marginTop="28dp" android:text="Khôi phục mật khẩu" android:textStyle="bold"
   android:textColor="@color/forgot_white" android:textSize="21sp"/>
  <TextView android:id="@+id/forgotSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:layout_marginTop="8dp" android:text="Chọn kênh nhận mã" android:textStyle="bold"
   android:textColor="@color/forgot_yellow" android:textSize="26sp"/>
  <TextView android:id="@+id/forgotDescription" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:layout_marginTop="8dp" android:text="Chọn Gmail (email OTP) hoặc số điện thoại (Zalo OTP)."
   android:textColor="@color/forgot_secondary" android:textSize="14sp"/>
  <LinearLayout android:id="@+id/forgotChannelSection" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:orientation="vertical" android:layout_marginTop="28dp">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="Kênh nhận mã" android:textColor="@color/forgot_white" android:textStyle="bold" android:textSize="14sp"/>
   <RadioGroup android:id="@+id/forgotChannels" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="10dp" android:background="@drawable/forgot_bg_input" android:padding="12dp"
    android:orientation="vertical">
    <RadioButton android:id="@+id/forgotEmail" android:layout_width="match_parent" android:layout_height="48dp"
     android:buttonTint="@color/forgot_mint" android:checked="true" android:text="Gmail · Email OTP"
     android:textColor="@color/forgot_white" android:textSize="15sp"/>
    <RadioButton android:id="@+id/forgotPhone" android:layout_width="match_parent" android:layout_height="48dp"
     android:buttonTint="@color/forgot_mint" android:text="SĐT · Zalo OTP"
     android:textColor="@color/forgot_white" android:textSize="15sp"/>
   </RadioGroup>
  </LinearLayout>
  <TextView android:id="@+id/forgotAccountLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:layout_marginTop="26dp" android:text="Tên đăng nhập / liên hệ" android:textStyle="bold"
   android:textSize="14sp" android:textColor="@color/forgot_white"/>
  <EditText android:id="@+id/forgotAccount" android:layout_width="match_parent" android:layout_height="58dp"
   android:layout_marginTop="10dp" android:background="@drawable/forgot_bg_input"
   android:paddingStart="16dp" android:paddingEnd="16dp" android:textColor="@color/forgot_white"
   android:textColorHint="@color/forgot_secondary" android:textSize="15sp" android:singleLine="true"
   android:inputType="text" android:hint="Nhập tài khoản hoặc liên hệ đã lưu"/>
  <Button android:id="@+id/forgotSend" android:layout_width="match_parent" android:layout_height="56dp"
   android:layout_marginTop="26dp" android:background="@drawable/forgot_bg_button"
   android:backgroundTint="@null" android:text="Gửi mã  →" android:textAllCaps="false"
   android:textColor="@color/forgot_bg" android:textStyle="bold" android:textSize="16sp"/>
  <TextView android:id="@+id/forgotStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:layout_marginTop="14dp" android:textColor="@color/forgot_yellow" android:textSize="14sp"
   android:visibility="gone" />
 </LinearLayout>
</ScrollView>
