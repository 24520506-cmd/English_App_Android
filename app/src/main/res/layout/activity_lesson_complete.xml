<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/app_night_bg">
    <com.example.english_app.StarfieldView android:layout_width="match_parent" android:layout_height="match_parent" />
    <ScrollView android:id="@+id/rootScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:id="@+id/contentColumn" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="26dp" android:paddingBottom="44dp">
            <TextView android:id="@+id/back" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="← Quay lại" android:textColor="@color/lv_mint" android:textSize="14sp" android:layout_marginTop="0dp" android:padding="8dp" android:textStyle="bold" />
            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Hoàn thành bài học" android:textColor="@color/lv_text" android:textSize="23sp" android:layout_marginTop="22dp" android:padding="0dp" android:textStyle="bold" />
            <TextView android:id="@+id/eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="✓ HOÀN THÀNH!" android:textColor="@color/lv_yellow" android:textSize="14sp" android:layout_marginTop="9dp" android:padding="0dp" android:textStyle="bold" />
            <TextView android:id="@+id/done" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="XONG!" android:textColor="@color/lv_mint" android:textSize="26sp" android:layout_marginTop="16dp" android:padding="0dp" android:textStyle="bold" />
            <TextView android:id="@+id/doneDesc" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Đã hoàn thành các bước của bài học minh họa." android:textColor="@color/lv_muted" android:textSize="14sp" android:layout_marginTop="7dp" android:padding="0dp" />
            <LinearLayout android:id="@+id/summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="vertical" android:background="@drawable/lv_panel" android:padding="16dp">
                <TextView android:id="@+id/summaryTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="7 TỪ ĐÃ HỌC" android:textColor="@color/lv_text" android:textSize="15sp" android:layout_marginTop="0dp" android:padding="0dp" android:textStyle="bold" />
                <TextView android:id="@+id/summaryBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Personal Finance &amp; Budgeting — Part 1" android:textColor="@color/lv_muted" android:textSize="13sp" android:layout_marginTop="6dp" android:padding="0dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/words" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:background="@drawable/lv_panel" android:padding="16dp">
                <TextView android:id="@+id/wordsTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Từ vựng mục tiêu" android:textColor="@color/lv_text" android:textSize="15sp" android:layout_marginTop="0dp" android:padding="0dp" android:textStyle="bold" />
                <TextView android:id="@+id/wordsBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="✓ Discretionary spending&#10;✓ Household budget&#10;✓ Financial literacy&#10;✓ To tighten one’s belt&#10;✓ Emergency fund&#10;✓ Expenditure&#10;✓ Living paycheck to paycheck" android:textColor="@color/lv_muted" android:textSize="13sp" android:layout_marginTop="6dp" android:padding="0dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/points" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:background="@drawable/lv_panel" android:padding="16dp">
                <TextView android:id="@+id/pointsTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Điểm học tập minh họa" android:textColor="@color/lv_text" android:textSize="15sp" android:layout_marginTop="0dp" android:padding="0dp" android:textStyle="bold" />
                <TextView android:id="@+id/pointsBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Điểm thực nhận sẽ được cập nhật khi có dữ liệu học tập." android:textColor="@color/lv_muted" android:textSize="13sp" android:layout_marginTop="6dp" android:padding="0dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/schedule" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:background="@drawable/lv_panel" android:padding="16dp">
                <TextView android:id="@+id/scheduleTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Lịch ôn" android:textColor="@color/lv_text" android:textSize="15sp" android:layout_marginTop="0dp" android:padding="0dp" android:textStyle="bold" />
                <TextView android:id="@+id/scheduleBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ôn tập vào D+1, D+3, D+7 tính theo ngày hoàn thành." android:textColor="@color/lv_muted" android:textSize="13sp" android:layout_marginTop="6dp" android:padding="0dp" />
            </LinearLayout>
            <Button android:id="@+id/feedback" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="18dp" android:background="@drawable/lv_button" android:backgroundTint="@null" android:text="Xem nhận xét bài viết  →" android:textAllCaps="false" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/lv_bg" />
            <Button android:id="@+id/finishStepTwo" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:background="@drawable/lv_button" android:backgroundTint="@null" android:text="Hoàn thành · Về trang chủ" android:textAllCaps="false" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/lv_bg" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
