<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/app_night_bg">
    <com.example.english_app.StarfieldView android:layout_width="match_parent" android:layout_height="match_parent" />
    <ScrollView android:id="@+id/rootScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:id="@+id/contentColumn" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="26dp" android:paddingBottom="44dp">
            <TextView android:id="@+id/back" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="← Quay lại" android:textColor="@color/lv_mint" android:textSize="14sp" android:layout_marginTop="0dp" android:padding="8dp" android:textStyle="bold" />
            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Luyện nghe" android:textColor="@color/lv_text" android:textSize="23sp" android:layout_marginTop="22dp" android:padding="0dp" android:textStyle="bold" />
            <TextView android:id="@+id/eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="✦ BƯỚC 2 / 3 — LUYỆN NGHE" android:textColor="@color/lv_yellow" android:textSize="14sp" android:layout_marginTop="9dp" android:padding="0dp" android:textStyle="bold" />
            <TextView android:id="@+id/step" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Từ vựng   →   Nghe   →   Viết" android:textColor="@color/lv_mint" android:textSize="13sp" android:layout_marginTop="11dp" android:padding="0dp" />
            <TextView android:id="@+id/sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LISTENING PRACTICE" android:textColor="@color/lv_yellow" android:textSize="20sp" android:layout_marginTop="22dp" android:padding="0dp" android:textStyle="bold" />
            <TextView android:id="@+id/desc" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nghe đoạn hội thoại chứa các từ đã học." android:textColor="@color/lv_muted" android:textSize="14sp" android:layout_marginTop="5dp" android:padding="0dp" />
            <LinearLayout android:id="@+id/audio" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="vertical" android:background="@drawable/lv_panel" android:padding="16dp">
                <TextView android:id="@+id/audioTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Trình phát audio" android:textColor="@color/lv_text" android:textSize="15sp" android:layout_marginTop="0dp" android:padding="0dp" android:textStyle="bold" />
                <TextView android:id="@+id/audioBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tiến độ nghe minh họa; chưa có âm thanh." android:textColor="@color/lv_muted" android:textSize="13sp" android:layout_marginTop="6dp" android:padding="0dp" />
                <Button android:id="@+id/play" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:background="@drawable/lv_button" android:backgroundTint="@null" android:text="▶ Phát / Tạm dừng" android:textAllCaps="false" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/lv_bg" />
                <ProgressBar android:id="@+id/audioProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="16dp" android:max="100" android:progress="0" android:progressTint="@color/lv_mint" android:progressBackgroundTint="@color/lv_muted" />
                <TextView android:id="@+id/audioTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="end" android:text="00:00 / 00:30" android:textColor="@color/lv_muted" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:id="@+id/questions" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CÂU HỎI NGHE HIỂU" android:textColor="@color/lv_muted" android:textSize="13sp" android:layout_marginTop="20dp" android:padding="0dp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/question1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" android:background="@drawable/lv_panel" android:padding="16dp">
                <TextView android:id="@+id/question1Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Câu 1" android:textColor="@color/lv_text" android:textSize="15sp" android:layout_marginTop="0dp" android:padding="0dp" android:textStyle="bold" />
                <TextView android:id="@+id/question1Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="What are the speakers discussing?" android:textColor="@color/lv_muted" android:textSize="13sp" android:layout_marginTop="6dp" android:padding="0dp" />
                <RadioGroup android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <RadioButton android:id="@+id/q0" android:layout_width="match_parent" android:layout_height="48dp" android:text="Monthly expenses" android:textColor="@color/lv_text" android:buttonTint="@color/lv_mint" android:textSize="14sp" />
                    <RadioButton android:id="@+id/q1" android:layout_width="match_parent" android:layout_height="48dp" android:text="Holiday plans" android:textColor="@color/lv_text" android:buttonTint="@color/lv_mint" android:textSize="14sp" />
                    <RadioButton android:id="@+id/q2" android:layout_width="match_parent" android:layout_height="48dp" android:text="School exams" android:textColor="@color/lv_text" android:buttonTint="@color/lv_mint" android:textSize="14sp" />
                </RadioGroup>
            </LinearLayout>
            <LinearLayout android:id="@+id/gap" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:background="@drawable/lv_panel" android:padding="16dp">
                <TextView android:id="@+id/gapTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ĐIỀN TỪ CÒN THIẾU" android:textColor="@color/lv_text" android:textSize="15sp" android:layout_marginTop="0dp" android:padding="0dp" android:textStyle="bold" />
                <TextView android:id="@+id/gapBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="They need an ______ fund." android:textColor="@color/lv_muted" android:textSize="13sp" android:layout_marginTop="6dp" android:padding="0dp" />
                <EditText android:id="@+id/answer" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="10dp" android:background="@drawable/lv_panel" android:padding="14dp" android:gravity="top|start" android:hint="Nhập từ còn thiếu" android:textColor="@color/lv_text" android:textColorHint="@color/lv_muted" android:textSize="15sp" android:inputType="textMultiLine" android:minLines="2" />
            </LinearLayout>
            <TextView android:id="@+id/notice" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="@color/lv_yellow" android:textSize="13sp" android:layout_marginTop="12dp" android:padding="0dp" />
            <Button android:id="@+id/submit" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="18dp" android:background="@drawable/lv_button" android:backgroundTint="@null" android:text="Nộp bài nghe  →" android:textAllCaps="false" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/lv_bg" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
