<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/app_night_bg">
    <com.example.english_app.StarfieldView android:layout_width="match_parent" android:layout_height="match_parent" />
    <ScrollView android:id="@+id/rootScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:id="@+id/contentColumn" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="26dp" android:paddingBottom="44dp">
            <TextView android:id="@+id/back" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="← Quay lại" android:textColor="@color/lv_mint" android:textSize="14sp" android:layout_marginTop="0dp" android:padding="8dp" android:textStyle="bold" />
            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Kết quả nghe" android:textColor="@color/lv_text" android:textSize="23sp" android:layout_marginTop="22dp" android:padding="0dp" android:textStyle="bold" />
            <TextView android:id="@+id/eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="KẾT QUẢ BÀI TẬP MINH HỌA" android:textColor="@color/lv_yellow" android:textSize="14sp" android:layout_marginTop="9dp" android:padding="0dp" android:textStyle="bold" />
            <TextView android:id="@+id/result" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Đã hoàn thành phần câu hỏi minh họa" android:textColor="@color/lv_muted" android:textSize="14sp" android:layout_marginTop="8dp" android:padding="0dp" />
            <LinearLayout android:id="@+id/explain" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="vertical" android:background="@drawable/lv_panel" android:padding="16dp">
                <TextView android:id="@+id/explainTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Đáp án &amp; giải thích" android:textColor="@color/lv_text" android:textSize="15sp" android:layout_marginTop="0dp" android:padding="0dp" android:textStyle="bold" />
                <TextView android:id="@+id/explainBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Đáp án mẫu: Monthly expenses · emergency fund." android:textColor="@color/lv_muted" android:textSize="13sp" android:layout_marginTop="6dp" android:padding="0dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/transcript" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:background="@drawable/lv_panel" android:padding="16dp">
                <TextView android:id="@+id/transcriptTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Transcript" android:textColor="@color/lv_text" android:textSize="15sp" android:layout_marginTop="0dp" android:padding="0dp" android:textStyle="bold" />
                <TextView android:id="@+id/transcriptBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Chỉ xuất hiện sau khi nộp bài nghe." android:textColor="@color/lv_muted" android:textSize="13sp" android:layout_marginTop="6dp" android:padding="0dp" />
                <TextView android:id="@+id/transcriptText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="A: How can we save more?&#10;B: Let’s review our monthly expenses and build an emergency fund." android:textColor="@color/lv_text" android:textSize="14sp" android:layout_marginTop="12dp" android:padding="0dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/retry" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:background="@drawable/lv_panel" android:padding="16dp">
                <TextView android:id="@+id/retryTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Luyện lại" android:textColor="@color/lv_text" android:textSize="15sp" android:layout_marginTop="0dp" android:padding="0dp" android:textStyle="bold" />
                <TextView android:id="@+id/retryBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bạn có thể luyện lại phần câu hỏi minh họa." android:textColor="@color/lv_muted" android:textSize="13sp" android:layout_marginTop="6dp" android:padding="0dp" />
            </LinearLayout>
            <Button android:id="@+id/next" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp" android:background="@drawable/lv_button" android:backgroundTint="@null" android:text="Tiếp tục đến phần viết  →" android:textAllCaps="false" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/lv_bg" />
            <Button android:id="@+id/repeat" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:background="@drawable/lv_button" android:backgroundTint="@null" android:text="Nghe luyện thêm" android:textAllCaps="false" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/lv_bg" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>