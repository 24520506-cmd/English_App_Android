<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_night_bg"
    android:fillViewport="true"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">
        <TextView
            android:id="@+id/obBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="‹  Quay lại"
            android:textColor="@color/ob_mint"
            android:textSize="15sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
        <LinearLayout
            android:id="@+id/obHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chọn mức nội dung"
                android:textColor="@color/ob_white"
                android:textSize="22sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Bạn muốn học mức nào?"
                android:textColor="@color/ob_yellow"
                android:textSize="25sp"
                android:textStyle="bold" />
        </LinearLayout>
        <TextView
            android:id="@+id/obDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="24dp"
            android:text="Đây là mức bài học mong muốn, không phải band IELTS được đánh giá."
            android:textColor="@color/ob_muted"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />
        <LinearLayout
            android:id="@+id/obBandsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
        <TextView
            android:id="@+id/obContinue"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/ob_continue_disabled"
            android:gravity="center"
            android:text="Đang tải mức nội dung…"
            android:textColor="@color/ob_white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:enabled="false" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Bạn có thể đổi mức nội dung sau trong Hồ sơ."
            android:gravity="center"
            android:textColor="@color/ob_muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
