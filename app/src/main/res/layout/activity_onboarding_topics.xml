<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_night_bg"
    android:fillViewport="true"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="620dp"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="38dp"
        android:paddingBottom="32dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/obBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="‹  Quay lại"
            android:textColor="@color/ob_mint"
            android:textSize="15sp"
            android:textStyle="bold"
            android:contentDescription="Quay lại" />
        <TextView
            android:id="@+id/obTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Chọn chủ đề ưu tiên"
            android:textColor="@color/ob_white"
            android:textSize="23sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/obSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Học điều bạn thích"
            android:textColor="@color/ob_yellow"
            android:textSize="25sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/obDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Chọn ít nhất một chủ đề. Bạn có thể thay đổi sau."
            android:textColor="@color/ob_muted"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/obSelectionNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Đang tải chủ đề..."
            android:textColor="@color/ob_mint"
            android:textSize="13sp" />
        <LinearLayout
            android:id="@+id/obTopicsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
        <FrameLayout
            android:id="@+id/obContinueWrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">
            <TextView
                android:id="@+id/obContinue"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center"
                android:background="@drawable/ob_cta"
                android:text="Tiếp tục  →"
                android:textColor="@color/ob_background"
                android:textStyle="bold"
                android:textSize="16sp"
                android:alpha="0.5"
                android:enabled="false" />
        </FrameLayout>
    </LinearLayout>
</ScrollView>
