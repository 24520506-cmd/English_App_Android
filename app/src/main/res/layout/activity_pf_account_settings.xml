<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/app_night_bg">
    <com.example.english_app.StarfieldView android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" />
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:id="@+id/pfContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="24dp" android:paddingBottom="96dp">
            <TextView android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="16dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:text="‹  Quay lại" android:textColor="@color/pf_mint" android:textSize="14sp" android:layout_marginTop="0dp" android:lineSpacingExtra="3dp" android:textStyle="bold" android:id="@+id/pfBack" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tài khoản &amp; bảo mật" android:textColor="@color/pf_text" android:textSize="24sp" android:layout_marginTop="24dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CÀI ĐẶT TÀI KHOẢN" android:textColor="@color/pf_gold" android:textSize="21sp" android:layout_marginTop="11dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tên hiển thị, liên hệ, mật khẩu và các phiên đăng nhập." android:textColor="@color/pf_muted" android:textSize="13sp" android:layout_marginTop="7dp" android:lineSpacingExtra="3dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginTop="12dp" android:background="@drawable/pf_card_bg" android:id="@+id/pfOpenEditName" android:foreground="?android:attr/selectableItemBackground" android:focusable="true">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tên hiển thị" android:textColor="@color/pf_text" android:textSize="15sp" android:layout_marginTop="0dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Đổi tên xuất hiện trong lời chào trên trang Học" android:textColor="@color/pf_muted" android:textSize="13sp" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginTop="12dp" android:background="@drawable/pf_card_bg">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Email" android:textColor="@color/pf_text" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/pfEmailVerificationStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Đang tải…" android:textColor="@color/pf_muted" android:textSize="13sp" android:layout_marginTop="6dp" />
                <Button android:id="@+id/pfVerifyEmail" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:background="@drawable/pf_outline_bg" android:backgroundTint="@null" android:text="Xác minh email" android:textAllCaps="false" android:textColor="@color/pf_mint" android:textStyle="bold" android:visibility="gone" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginTop="12dp" android:background="@drawable/pf_card_bg" android:id="@+id/pfOpenChangePassword" android:foreground="?android:attr/selectableItemBackground" android:focusable="true">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Đổi mật khẩu ›" android:textColor="@color/pf_text" android:textSize="15sp" android:layout_marginTop="0dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sau khi đổi phải đăng nhập lại trên mọi thiết bị" android:textColor="@color/pf_muted" android:textSize="13sp" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginTop="12dp" android:background="@drawable/pf_card_bg" android:id="@+id/pfOpenSessions" android:foreground="?android:attr/selectableItemBackground" android:focusable="true">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Quản lý phiên ›" android:textColor="@color/pf_text" android:textSize="15sp" android:layout_marginTop="0dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Xem và thu hồi các phiên còn hoạt động" android:textColor="@color/pf_muted" android:textSize="13sp" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
