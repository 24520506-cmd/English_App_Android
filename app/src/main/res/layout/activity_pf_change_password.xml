<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/app_night_bg">
    <com.example.english_app.StarfieldView android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" />
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:id="@+id/pfContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="24dp" android:paddingBottom="96dp">
            <TextView android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="16dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:text="‹  Quay lại" android:textColor="@color/pf_mint" android:textSize="14sp" android:layout_marginTop="0dp" android:lineSpacingExtra="3dp" android:textStyle="bold" android:id="@+id/pfBack" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Đổi mật khẩu" android:textColor="@color/pf_text" android:textSize="24sp" android:layout_marginTop="24dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="BẢO MẬT TÀI KHOẢN" android:textColor="@color/pf_gold" android:textSize="21sp" android:layout_marginTop="11dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Đổi mật khẩu sẽ kết thúc mọi phiên đăng nhập." android:textColor="@color/pf_muted" android:textSize="13sp" android:layout_marginTop="7dp" android:lineSpacingExtra="3dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mật khẩu hiện tại" android:textColor="@color/pf_text" android:textSize="14sp" android:layout_marginTop="20dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
            <EditText android:id="@+id/pfOldPwd" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="58dp" android:layout_marginTop="10dp" android:background="@drawable/pf_field_bg" android:hint="Nhập mật khẩu đang dùng" android:inputType="textPassword" android:textColor="@color/pf_text" android:textColorHint="@color/pf_muted" android:textSize="15sp" android:padding="16dp" android:gravity="top|start" android:minLines="1" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mật khẩu mới" android:textColor="@color/pf_text" android:textSize="14sp" android:layout_marginTop="16dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
            <EditText android:id="@+id/pfNewPwd" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="58dp" android:layout_marginTop="10dp" android:background="@drawable/pf_field_bg" android:hint="Nhập mật khẩu mới" android:inputType="textPassword" android:textColor="@color/pf_text" android:textColorHint="@color/pf_muted" android:textSize="15sp" android:padding="16dp" android:gravity="top|start" android:minLines="1" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Xác nhận mật khẩu mới" android:textColor="@color/pf_text" android:textSize="14sp" android:layout_marginTop="16dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
            <EditText android:id="@+id/pfConfirmPwd" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="58dp" android:layout_marginTop="10dp" android:background="@drawable/pf_field_bg" android:hint="Nhập lại mật khẩu mới" android:inputType="textPassword" android:textColor="@color/pf_text" android:textColorHint="@color/pf_muted" android:textSize="15sp" android:padding="16dp" android:gravity="top|start" android:minLines="1" />
            <Button android:id="@+id/pfChangePwd" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="18dp" android:background="@drawable/pf_button_bg" android:backgroundTint="@null" android:text="Đổi mật khẩu →" android:textAllCaps="false" android:textColor="@color/pf_bg" android:textStyle="bold" android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>