<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/app_night_bg">
    <com.example.english_app.StarfieldView android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" />
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:id="@+id/pfContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="24dp" android:paddingBottom="96dp">
            <TextView android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="16dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:text="‹  Quay lại" android:textColor="@color/pf_mint" android:textSize="14sp" android:layout_marginTop="0dp" android:lineSpacingExtra="3dp" android:textStyle="bold" android:id="@+id/pfBack" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tùy chọn học tập" android:textColor="@color/pf_text" android:textSize="24sp" android:layout_marginTop="24dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="THIẾT LẬP NỘI DUNG" android:textColor="@color/pf_gold" android:textSize="21sp" android:layout_marginTop="11dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Đổi band hoặc chủ đề không làm mất tiến độ." android:textColor="@color/pf_muted" android:textSize="13sp" android:layout_marginTop="7dp" android:lineSpacingExtra="3dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mức nội dung muốn học" android:textColor="@color/pf_text" android:textSize="15sp" android:layout_marginTop="21dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/pfBandsContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <CheckBox android:id="@+id/pfBand0" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="&lt;5.5" android:textColor="@color/pf_text" android:textSize="15sp" android:buttonTint="@color/pf_mint" android:padding="4dp" />
            <CheckBox android:id="@+id/pfBand1" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="5.5–6.0" android:textColor="@color/pf_text" android:textSize="15sp" android:buttonTint="@color/pf_mint" android:padding="4dp" />
            <CheckBox android:id="@+id/pfBand2" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="6.0–6.5" android:textColor="@color/pf_text" android:textSize="15sp" android:buttonTint="@color/pf_mint" android:padding="4dp" />
            <CheckBox android:id="@+id/pfBand3" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="6.5–7.0" android:textColor="@color/pf_text" android:textSize="15sp" android:buttonTint="@color/pf_mint" android:padding="4dp" />
            <CheckBox android:id="@+id/pfBand4" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="7.0–7.5" android:textColor="@color/pf_text" android:textSize="15sp" android:buttonTint="@color/pf_mint" android:padding="4dp" />
            <CheckBox android:id="@+id/pfBand5" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="7.5–8.0" android:textColor="@color/pf_text" android:textSize="15sp" android:buttonTint="@color/pf_mint" android:padding="4dp" />
            <CheckBox android:id="@+id/pfBand6" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="8+" android:textColor="@color/pf_text" android:textSize="15sp" android:buttonTint="@color/pf_mint" android:padding="4dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Chủ đề ưu tiên" android:textColor="@color/pf_text" android:textSize="15sp" android:layout_marginTop="18dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/pfTopicsContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <CheckBox android:id="@+id/pfTopic0" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Daily Life" android:textColor="@color/pf_text" android:textSize="15sp" android:buttonTint="@color/pf_mint" android:padding="4dp" />
            <CheckBox android:id="@+id/pfTopic1" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Education" android:textColor="@color/pf_text" android:textSize="15sp" android:buttonTint="@color/pf_mint" android:padding="4dp" />
            <CheckBox android:id="@+id/pfTopic2" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Technology" android:textColor="@color/pf_text" android:textSize="15sp" android:buttonTint="@color/pf_mint" android:padding="4dp" />
            <CheckBox android:id="@+id/pfTopic3" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Environment" android:textColor="@color/pf_text" android:textSize="15sp" android:buttonTint="@color/pf_mint" android:padding="4dp" />
            <CheckBox android:id="@+id/pfTopic4" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Finance" android:textColor="@color/pf_text" android:textSize="15sp" android:buttonTint="@color/pf_mint" android:padding="4dp" />
            <CheckBox android:id="@+id/pfTopic5" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Travel" android:textColor="@color/pf_text" android:textSize="15sp" android:buttonTint="@color/pf_mint" android:padding="4dp" />
            <CheckBox android:id="@+id/pfTopic6" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Health" android:textColor="@color/pf_text" android:textSize="15sp" android:buttonTint="@color/pf_mint" android:padding="4dp" />
            <CheckBox android:id="@+id/pfTopic7" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Work" android:textColor="@color/pf_text" android:textSize="15sp" android:buttonTint="@color/pf_mint" android:padding="4dp" />
            <Button android:id="@+id/pfSavePreferences" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="18dp" android:background="@drawable/pf_button_bg" android:backgroundTint="@null" android:text="Lưu lựa chọn →" android:textAllCaps="false" android:textColor="@color/pf_bg" android:textStyle="bold" android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
