<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/app_night_bg">
    <com.example.english_app.StarfieldView android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" />
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:id="@+id/pfContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="24dp" android:paddingBottom="96dp">
            <TextView android:id="@+id/pfBack" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="16dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:text="‹  Quay lại" android:textColor="@color/pf_mint" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Hồ sơ" android:textColor="@color/pf_text" android:textSize="24sp" android:layout_marginTop="4dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginTop="12dp" android:background="@drawable/pf_card_bg">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="◉  NGƯỜI HỌC" android:textColor="@color/pf_text" android:textSize="15sp" android:layout_marginTop="0dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
                <TextView android:id="@+id/pfAccountUsername" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Đang tải thông tin tài khoản…" android:textColor="@color/pf_muted" android:textSize="13sp" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" />
                <TextView android:id="@+id/pfProfileDisplayName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Tên hiển thị: đang tải…" android:textColor="@color/pf_text" android:textSize="14sp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="HỌC TẬP" android:textColor="@color/pf_muted" android:textSize="12sp" android:layout_marginTop="23dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginTop="12dp" android:background="@drawable/pf_card_bg" android:id="@+id/pfOpenPreferences" android:foreground="?android:attr/selectableItemBackground" android:focusable="true">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Chọn band và chủ đề" android:textColor="@color/pf_text" android:textSize="15sp" android:layout_marginTop="0dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Đổi mức bài muốn học, không mất lịch sử" android:textColor="@color/pf_muted" android:textSize="13sp" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginTop="12dp" android:background="@drawable/pf_card_bg" android:id="@+id/pfOpenHistory" android:foreground="?android:attr/selectableItemBackground" android:focusable="true">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Lịch sử học" android:textColor="@color/pf_text" android:textSize="15sp" android:layout_marginTop="0dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bài đã học và nhận xét AI" android:textColor="@color/pf_muted" android:textSize="13sp" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CÀI ĐẶT" android:textColor="@color/pf_muted" android:textSize="12sp" android:layout_marginTop="22dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginTop="12dp" android:background="@drawable/pf_card_bg" android:id="@+id/pfOpenNotifications" android:foreground="?android:attr/selectableItemBackground" android:focusable="true">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nhắc ôn tập" android:textColor="@color/pf_text" android:textSize="15sp" android:layout_marginTop="0dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Xem thiết lập nhắc ôn mẫu D+1, D+3, D+7" android:textColor="@color/pf_muted" android:textSize="13sp" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginTop="12dp" android:background="@drawable/pf_card_bg" android:id="@+id/pfOpenAccount" android:foreground="?android:attr/selectableItemBackground" android:focusable="true">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Thông tin tài khoản" android:textColor="@color/pf_text" android:textSize="15sp" android:layout_marginTop="0dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tên hiển thị, bảo mật và phiên đăng nhập" android:textColor="@color/pf_muted" android:textSize="13sp" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" />
            </LinearLayout>
            <Button android:id="@+id/pfLogout" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="20dp" android:background="@drawable/pf_outline_bg" android:backgroundTint="@null" android:text="Đăng xuất" android:textAllCaps="false" android:textColor="@color/pf_mint" android:textStyle="bold" android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="62dp" android:layout_gravity="bottom" android:orientation="horizontal" android:background="@color/pf_surface" android:padding="4dp">
        <Button android:id="@+id/pfNav0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="Học" android:textSize="11sp" android:textAllCaps="false" android:textColor="@color/pf_text" android:backgroundTint="@color/pf_surface" />
        <Button android:id="@+id/pfNav1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="Ôn tập" android:textSize="11sp" android:textAllCaps="false" android:textColor="@color/pf_text" android:backgroundTint="@color/pf_surface" />
        <Button android:id="@+id/pfNav2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="Tiến độ" android:textSize="11sp" android:textAllCaps="false" android:textColor="@color/pf_text" android:backgroundTint="@color/pf_surface" />
        <Button android:id="@+id/pfNav3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="Xếp hạng" android:textSize="11sp" android:textAllCaps="false" android:textColor="@color/pf_text" android:backgroundTint="@color/pf_surface" />
        <Button android:id="@+id/pfNav4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="Hồ sơ" android:textSize="11sp" android:textAllCaps="false" android:textColor="@color/pf_text" android:backgroundTint="@color/pf_surface" />
    </LinearLayout>
</FrameLayout>
