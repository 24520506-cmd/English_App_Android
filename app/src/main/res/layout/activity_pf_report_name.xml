<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/app_night_bg">
    <com.example.english_app.StarfieldView android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" />
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:id="@+id/pfContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="24dp" android:paddingBottom="96dp">
            <TextView android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="16dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:text="‹  Quay lại" android:textColor="@color/pf_mint" android:textSize="14sp" android:layout_marginTop="0dp" android:lineSpacingExtra="3dp" android:textStyle="bold" android:id="@+id/pfBack" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Báo cáo tên" android:textColor="@color/pf_text" android:textSize="24sp" android:layout_marginTop="24dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="BÁO CÁO TÊN HIỂN THỊ" android:textColor="@color/pf_gold" android:textSize="21sp" android:layout_marginTop="11dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Chỉ báo cáo tên công khai không phù hợp." android:textColor="@color/pf_muted" android:textSize="13sp" android:layout_marginTop="7dp" android:lineSpacingExtra="3dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Lý do báo cáo" android:textColor="@color/pf_text" android:textSize="14sp" android:layout_marginTop="20dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
            <EditText android:id="@+id/pfReportReason" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="58dp" android:layout_marginTop="10dp" android:background="@drawable/pf_field_bg" android:hint="Mô tả ngắn..." android:inputType="text" android:textColor="@color/pf_text" android:textColorHint="@color/pf_muted" android:textSize="15sp" android:padding="16dp" android:gravity="top|start" android:minLines="3" />
            <Button android:id="@+id/pfReportSubmit" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="18dp" android:background="@drawable/pf_button_bg" android:backgroundTint="@null" android:text="Gửi báo cáo →" android:textAllCaps="false" android:textColor="@color/pf_bg" android:textStyle="bold" android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>