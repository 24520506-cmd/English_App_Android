<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/registerScroll" android:layout_width="match_parent" android:layout_height="match_parent"
 android:fillViewport="true" android:background="@drawable/app_night_bg" android:clipToPadding="false">
 <LinearLayout android:id="@+id/registerContent" android:layout_width="match_parent" android:layout_height="wrap_content"
  android:minHeight="700dp" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp"
  android:paddingTop="22dp" android:paddingBottom="30dp">
  <TextView android:id="@+id/backButton" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center_vertical"
   android:text="‹  Quay lại" android:textSize="15sp" android:textColor="@color/reg_mint" android:clickable="true" android:focusable="true"/>
  <LinearLayout android:id="@+id/registerHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="22dp">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tạo tài khoản" android:textColor="@color/reg_white" android:textSize="28sp" android:textStyle="bold"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Bắt đầu hành trình học mỗi ngày" android:textColor="@color/reg_muted" android:textSize="15sp"/>
   <View android:layout_width="46dp" android:layout_height="4dp" android:background="@drawable/bg_cta" android:layout_marginTop="18dp"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/registerForm" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="28dp">
   <LinearLayout android:id="@+id/registerUsernameGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TÊN ĐĂNG NHẬP" android:textColor="@color/reg_muted" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
    <EditText android:id="@+id/usernameInput" android:layout_width="match_parent" android:layout_height="58dp" android:background="@drawable/bg_input" android:paddingStart="16dp" android:paddingEnd="16dp" android:hint="Nhập tên đăng nhập" android:singleLine="true" android:inputType="textNoSuggestions" android:imeOptions="actionNext" android:textSize="16sp" android:textColor="@color/reg_white" android:textColorHint="@color/reg_muted"/>
   </LinearLayout>
   <LinearLayout android:id="@+id/registerPasswordGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="vertical">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MẬT KHẨU" android:textColor="@color/reg_muted" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
    <FrameLayout android:layout_width="match_parent" android:layout_height="58dp">
     <EditText android:id="@+id/passwordInput" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_input" android:paddingStart="16dp" android:paddingEnd="78dp" android:hint="Tạo mật khẩu" android:inputType="textPassword" android:singleLine="true" android:imeOptions="actionNext" android:textSize="16sp" android:textColor="@color/reg_white" android:textColorHint="@color/reg_muted"/>
     <TextView android:id="@+id/togglePassword" android:layout_width="72dp" android:layout_height="match_parent" android:layout_gravity="end" android:gravity="center" android:text="Hiện" android:textSize="14sp" android:textColor="@color/reg_mint" android:clickable="true" android:focusable="true"/>
    </FrameLayout>
   </LinearLayout>
   <LinearLayout android:id="@+id/registerConfirmGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="vertical">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="XÁC NHẬN MẬT KHẨU" android:textColor="@color/reg_muted" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
    <FrameLayout android:layout_width="match_parent" android:layout_height="58dp">
     <EditText android:id="@+id/confirmInput" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_input" android:paddingStart="16dp" android:paddingEnd="78dp" android:hint="Nhập lại mật khẩu" android:inputType="textPassword" android:singleLine="true" android:imeOptions="actionDone" android:textSize="16sp" android:textColor="@color/reg_white" android:textColorHint="@color/reg_muted"/>
     <TextView android:id="@+id/toggleConfirm" android:layout_width="72dp" android:layout_height="match_parent" android:layout_gravity="end" android:gravity="center" android:text="Hiện" android:textColor="@color/reg_mint" android:textSize="14sp" android:clickable="true" android:focusable="true"/>
    </FrameLayout>
   </LinearLayout>
   <TextView android:id="@+id/errorMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/reg_error" android:textSize="13sp" android:visibility="gone"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/contactNotice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:background="@drawable/bg_notice" android:padding="16dp" android:orientation="horizontal" android:gravity="top">
   <TextView android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/bg_chip" android:gravity="center" android:text="✓" android:textColor="@color/reg_mint" android:textSize="18sp"/>
   <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Liên hệ có thể thêm sau" android:textColor="@color/reg_white" android:textSize="15sp" android:textStyle="bold"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Bạn vẫn có thể học bình thường khi chưa thêm hoặc xác thực Gmail/SĐT." android:textColor="@color/reg_muted" android:textSize="13sp" android:lineSpacingExtra="2dp"/>
   </LinearLayout>
  </LinearLayout>
  <TextView android:id="@+id/createAccountButton" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="24dp" android:background="@drawable/bg_cta" android:gravity="center" android:text="Tạo tài khoản  →" android:textColor="@color/reg_dark" android:textSize="16sp" android:textStyle="bold" android:clickable="true" android:focusable="true"/>
  <TextView android:id="@+id/loginLink" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:gravity="center" android:text="Đã có tài khoản?  Đăng nhập" android:textColor="@color/reg_mint" android:textSize="14sp" android:clickable="true" android:focusable="true"/>
 </LinearLayout>
</ScrollView>
