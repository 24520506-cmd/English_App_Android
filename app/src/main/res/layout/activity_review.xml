<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/app_night_bg">
    <com.example.english_app.StarfieldView android:layout_width="match_parent" android:layout_height="match_parent" />
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:id="@+id/contentColumn" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="24dp" android:paddingBottom="44dp" android:orientation="vertical">
            <TextView android:id="@+id/backLink" android:layout_width="wrap_content" android:layout_height="48dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="16dp" android:text="← Quay lại" android:textSize="14sp" android:textColor="@color/rv_mint" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ôn tập" android:textSize="18sp" android:textColor="@color/rv_white" android:layout_marginTop="12dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ÔN TẬP THEO LỊCH" android:textSize="26sp" android:textColor="@color/rv_yellow" android:layout_marginTop="4dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Lịch D+1, D+3, D+7 dưới đây là minh họa." android:textSize="14sp" android:textColor="@color/rv_muted" android:layout_marginTop="8dp" android:lineSpacingExtra="3dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="BÀI ÔN GỢI Ý" android:textSize="13sp" android:textColor="@color/rv_mint" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@drawable/rv_card_bg" android:layout_marginTop="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="VÍ DỤ  •  Finance — Part 1" android:textSize="15sp" android:textColor="@color/rv_white" android:layout_marginTop="0dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mốc D+1 minh họa · Chưa tính điểm" android:textSize="13sp" android:textColor="@color/rv_muted" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" />
            </LinearLayout>
            <Button android:id="@+id/openDetail" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:text="Xem bài ôn  →" android:textAllCaps="false" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/rv_bg" android:background="@drawable/rv_action_bg" android:backgroundTint="@null" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@drawable/rv_card_bg" android:layout_marginTop="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SẮP TỚI  •  Finance — Part 2" android:textSize="15sp" android:textColor="@color/rv_white" android:layout_marginTop="0dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mốc D+3 minh họa" android:textSize="13sp" android:textColor="@color/rv_muted" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@drawable/rv_card_bg" android:layout_marginTop="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TỰ CHỌN  •  Ôn tự do" android:textSize="15sp" android:textColor="@color/rv_white" android:layout_marginTop="0dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Luyện lại bài đã học; không nhận điểm mốc ngoài ngày hiệu lực." android:textSize="13sp" android:textColor="@color/rv_muted" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" />
            </LinearLayout>
            <Button android:id="@+id/freeReview" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="16dp" android:text="Ôn tự do  →" android:textAllCaps="false" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/rv_mint" android:background="@drawable/rv_secondary_bg" android:backgroundTint="@null" />
            <Button android:id="@+id/notifyButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:text="Tạo lịch nhắc ôn  →" android:textAllCaps="false" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/rv_mint" android:background="@drawable/rv_secondary_bg" android:backgroundTint="@null" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
