<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/app_night_bg">
    <com.example.english_app.StarfieldView android:layout_width="match_parent" android:layout_height="match_parent" />
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:id="@+id/contentColumn" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="24dp" android:paddingBottom="44dp" android:orientation="vertical">
            <TextView android:id="@+id/backLink" android:layout_width="wrap_content" android:layout_height="48dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="16dp" android:text="← Quay lại" android:textSize="14sp" android:textColor="@color/rv_mint" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Chi tiết ôn tập" android:textSize="18sp" android:textColor="@color/rv_white" android:layout_marginTop="12dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ÔN LẠI PART 1" android:textSize="26sp" android:textColor="@color/rv_yellow" android:layout_marginTop="4dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mốc D+1 minh họa" android:textSize="14sp" android:textColor="@color/rv_muted" android:layout_marginTop="8dp" android:lineSpacingExtra="3dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@drawable/rv_card_bg" android:layout_marginTop="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TIẾN ĐỘ LỊCH ÔN" android:textSize="15sp" android:textColor="@color/rv_white" android:layout_marginTop="0dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="●  D+1    ○  D+3    ○  D+7" android:textSize="13sp" android:textColor="@color/rv_muted" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@drawable/rv_card_bg" android:layout_marginTop="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PHẠM VI ÔN" android:textSize="15sp" android:textColor="@color/rv_white" android:layout_marginTop="0dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ôn đủ 7 từ/cụm từ mục tiêu, luyện nghe và viết một câu theo tình huống." android:textSize="13sp" android:textColor="@color/rv_muted" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" />
            </LinearLayout>
            <Button android:id="@+id/startVocab" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="16dp" android:text="Bắt đầu ôn  →" android:textAllCaps="false" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/rv_bg" android:background="@drawable/rv_action_bg" android:backgroundTint="@null" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>