<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/app_night_bg">
    <com.example.english_app.StarfieldView android:layout_width="match_parent" android:layout_height="match_parent" />
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:id="@+id/contentColumn" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="24dp" android:paddingBottom="44dp" android:orientation="vertical">
            <TextView android:id="@+id/backLink" android:layout_width="wrap_content" android:layout_height="48dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="16dp" android:text="← Quay lại" android:textSize="14sp" android:textColor="@color/rv_mint" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nghe ôn tập" android:textSize="18sp" android:textColor="@color/rv_white" android:layout_marginTop="12dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LISTENING REVIEW" android:textSize="26sp" android:textColor="@color/rv_yellow" android:layout_marginTop="4dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Trả lời câu hỏi ngắn theo nội dung minh họa." android:textSize="14sp" android:textColor="@color/rv_muted" android:layout_marginTop="8dp" android:lineSpacingExtra="3dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@drawable/rv_card_bg" android:layout_marginTop="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="AUDIO  ▶" android:textSize="15sp" android:textColor="@color/rv_white" android:layout_marginTop="0dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
                <TextView android:id="@+id/reviewAudioStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nghe câu mẫu tiếng Anh rồi điền từ còn thiếu." android:textSize="13sp" android:textColor="@color/rv_muted" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" />
            </LinearLayout>
            <Button android:id="@+id/playAudio" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:text="▶ Nghe câu mẫu" android:textAllCaps="false" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/rv_bg" android:background="@drawable/rv_mint_bg" android:backgroundTint="@null" />
            <ProgressBar android:id="@+id/reviewAudioProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="14dp" android:max="100" android:progress="0" android:progressTint="@color/rv_mint" android:progressBackgroundTint="@color/rv_border" android:indeterminateTint="@color/rv_mint" android:contentDescription="Tiến độ phát câu mẫu" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="They need an ______ fund." android:textColor="@color/rv_white" android:textSize="15sp" android:textStyle="bold" android:labelFor="@id/fillAnswer" />
            <EditText android:id="@+id/fillAnswer" android:layout_width="match_parent" android:layout_height="56dp" android:minHeight="56dp" android:layout_marginTop="8dp" android:padding="16dp" android:background="@drawable/rv_input_bg" android:hint="Nhập từ còn thiếu…" android:textColor="@color/rv_white" android:textColorHint="@color/rv_muted" android:textSize="15sp" android:inputType="text" android:minLines="1" android:gravity="center_vertical" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bạn có thể nghe lại câu mẫu trước khi tiếp tục." android:textSize="13sp" android:textColor="@color/rv_muted" android:layout_marginTop="12dp" android:lineSpacingExtra="3dp" />
            <Button android:id="@+id/goWriting" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="16dp" android:text="Tiếp tục viết  →" android:textAllCaps="false" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/rv_bg" android:background="@drawable/rv_action_bg" android:backgroundTint="@null" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
