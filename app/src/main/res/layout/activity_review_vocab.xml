<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/app_night_bg">
    <com.example.english_app.StarfieldView android:layout_width="match_parent" android:layout_height="match_parent" />
    <ScrollView android:id="@+id/reviewScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:id="@+id/contentColumn" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="24dp" android:paddingBottom="44dp" android:orientation="vertical">
            <TextView android:id="@+id/backLink" android:layout_width="wrap_content" android:layout_height="48dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="16dp" android:text="← Quay lại" android:textSize="14sp" android:textColor="@color/rv_mint" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ôn từ vựng" android:textSize="18sp" android:textColor="@color/rv_white" android:layout_marginTop="12dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NHỚ TỪ TRONG NGỮ CẢNH" android:textSize="26sp" android:textColor="@color/rv_yellow" android:layout_marginTop="4dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Xem đủ 7 từ/cụm từ đã học." android:textSize="14sp" android:textColor="@color/rv_muted" android:layout_marginTop="8dp" android:lineSpacingExtra="3dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TỪ 1 / 7" android:textSize="13sp" android:textColor="@color/rv_mint" android:layout_marginTop="18dp" android:lineSpacingExtra="3dp" android:textStyle="bold" android:id="@+id/wordProgress" />
            <ProgressBar android:id="@+id/reviewWordBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="8dp" android:max="7" android:progress="1" android:progressTint="@color/rv_mint" android:progressBackgroundTint="@color/rv_border" />
            <LinearLayout android:id="@+id/reviewWordCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@drawable/rv_focus_bg" android:layout_marginTop="16dp">
                <TextView android:id="@+id/reviewWordTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Discretionary spending" android:textSize="22sp" android:textColor="@color/rv_white" android:layout_marginTop="0dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
                <TextView android:id="@+id/reviewWordMeaning" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Chi tiêu tùy ý" android:textSize="15sp" android:textColor="@color/rv_mint" android:layout_marginTop="8dp" android:lineSpacingExtra="3dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/reviewExampleCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@drawable/rv_card_bg" android:layout_marginTop="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ví dụ" android:textSize="15sp" android:textColor="@color/rv_white" android:layout_marginTop="0dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
                <TextView android:id="@+id/reviewWordExample" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="I want to cut my discretionary spending this month." android:textSize="13sp" android:textColor="@color/rv_muted" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/reviewContextCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@drawable/rv_card_bg" android:layout_marginTop="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tình huống sử dụng" android:textSize="15sp" android:textColor="@color/rv_white" android:layout_marginTop="0dp" android:lineSpacingExtra="3dp" android:textStyle="bold" />
                <TextView android:id="@+id/reviewWordContext" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bạn cân nhắc những khoản chi có thể giảm trong ngân sách cá nhân." android:textSize="13sp" android:textColor="@color/rv_muted" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" />
            </LinearLayout>
            <Button android:id="@+id/nextWord" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="16dp" android:text="Từ tiếp theo  →" android:textAllCaps="false" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/rv_bg" android:background="@drawable/rv_action_bg" android:backgroundTint="@null" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
