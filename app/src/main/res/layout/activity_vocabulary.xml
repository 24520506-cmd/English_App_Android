<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/app_night_bg">
<com.example.english_app.StarfieldView android:layout_width="match_parent" android:layout_height="match_parent"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="48dp" android:paddingBottom="16dp">
<TextView android:id="@+id/vocabBack" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center_vertical" android:text="‹  Quay lại" android:textColor="@color/lv_mint" android:textSize="14sp"/>
<TextView android:id="@+id/vocabHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Học từ vựng" android:textStyle="bold" android:textSize="25sp" android:textColor="@color/lv_text"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="Từ vựng  →  Nghe  →  Viết" android:textStyle="bold" android:textColor="@color/lv_mint" android:textSize="13sp"/>
<TextView android:id="@+id/vocabCounter" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="23dp" android:text="TỪ 1 TRONG 7" android:textStyle="bold" android:textColor="@color/lv_mint" android:textSize="12sp"/>
<LinearLayout android:id="@+id/progressSegments" android:layout_width="match_parent" android:layout_height="7dp" android:layout_marginTop="12dp" android:orientation="horizontal"/>
<TextView android:id="@+id/wordTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="Discretionary spending" android:textStyle="bold" android:textSize="26sp" android:textColor="@color/lv_yellow"/>
<TextView android:id="@+id/wordMeaning" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Chi tiêu tùy ý" android:textColor="@color/lv_muted" android:textSize="15sp"/>
<LinearLayout android:id="@+id/sectionPronunciation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="21dp" android:padding="16dp" android:orientation="vertical" android:background="@drawable/lv_panel"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Phiên âm &amp; phát âm" android:textColor="@color/lv_text" android:textStyle="bold" android:textSize="16sp"/><TextView android:id="@+id/wordIpa" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:text="/dɪˈskreʃəneri ˈspendɪŋ/    ▶ Phát audio" android:textColor="@color/lv_mint" android:textSize="14sp"/></LinearLayout>
<LinearLayout android:id="@+id/sectionExample" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:padding="16dp" android:orientation="vertical" android:background="@drawable/lv_panel"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Câu ví dụ" android:textColor="@color/lv_text" android:textStyle="bold" android:textSize="16sp"/><TextView android:id="@+id/wordExample" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="I want to cut my discretionary spending this month." android:lineSpacingExtra="4dp" android:textColor="@color/lv_muted" android:textSize="15sp"/></LinearLayout>
<LinearLayout android:id="@+id/sectionDialogue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:padding="16dp" android:orientation="vertical" android:background="@drawable/lv_panel"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Hội thoại ngắn" android:textColor="@color/lv_text" android:textStyle="bold" android:textSize="16sp"/><TextView android:id="@+id/wordDialogue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="A: How can we save more?&#10;B: Let's review our monthly expenses." android:lineSpacingExtra="5dp" android:textColor="@color/lv_muted" android:textSize="15sp"/></LinearLayout>
<LinearLayout android:id="@+id/sectionUsage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:padding="16dp" android:orientation="vertical" android:background="@drawable/lv_panel"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tình huống sử dụng" android:textColor="@color/lv_text" android:textStyle="bold" android:textSize="16sp"/><TextView android:id="@+id/wordUsage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="Diễn đạt một kế hoạch chi tiêu thực tế trong cuộc sống." android:lineSpacingExtra="4dp" android:textColor="@color/lv_muted" android:textSize="15sp"/></LinearLayout>
<TextView android:id="@+id/vocabNext" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp" android:background="@drawable/lv_button" android:gravity="center" android:text="Tiếp tục" android:textColor="@color/lv_bg" android:textStyle="bold" android:textSize="16sp"/>
</LinearLayout></ScrollView></LinearLayout>
</FrameLayout>
