<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/app_night_bg">
    <com.example.english_app.StarfieldView android:layout_width="match_parent" android:layout_height="match_parent" />
    <ScrollView android:id="@+id/rootScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:id="@+id/contentColumn" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="26dp" android:paddingBottom="44dp">
            <TextView android:id="@+id/back" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="← Quay lại" android:textColor="@color/lv_mint" android:textSize="14sp" android:layout_marginTop="0dp" android:padding="8dp" android:textStyle="bold" />
            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Luyện viết" android:textColor="@color/lv_text" android:textSize="23sp" android:layout_marginTop="22dp" android:padding="0dp" android:textStyle="bold" />
            <TextView android:id="@+id/eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="✦ BƯỚC 3 / 3 — LUYỆN VIẾT" android:textColor="@color/lv_yellow" android:textSize="14sp" android:layout_marginTop="9dp" android:padding="0dp" android:textStyle="bold" />
            <TextView android:id="@+id/step" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Từ vựng   →   Nghe   →   Viết" android:textColor="@color/lv_mint" android:textSize="13sp" android:layout_marginTop="11dp" android:padding="0dp" />
            <TextView android:id="@+id/heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="WRITE IN CONTEXT" android:textColor="@color/lv_yellow" android:textSize="20sp" android:layout_marginTop="20dp" android:padding="0dp" android:textStyle="bold" />
            <TextView android:id="@+id/intro" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Viết mỗi câu riêng cho một tình huống. Không có giới hạn số từ." android:textColor="@color/lv_muted" android:textSize="14sp" android:layout_marginTop="6dp" android:padding="0dp" />
            <LinearLayout android:id="@+id/prompt1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="vertical" android:background="@drawable/lv_panel" android:padding="16dp">
                <TextView android:id="@+id/prompt1Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tình huống 1 · Emergency fund" android:textColor="@color/lv_text" android:textSize="15sp" android:layout_marginTop="0dp" android:padding="0dp" android:textStyle="bold" />
                <TextView android:id="@+id/prompt1Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bạn khuyên một người bạn nên dành tiền cho các trường hợp bất ngờ." android:textColor="@color/lv_muted" android:textSize="13sp" android:layout_marginTop="6dp" android:padding="0dp" />
            </LinearLayout>
            <EditText android:id="@+id/sentence1" android:layout_width="match_parent" android:layout_height="94dp" android:layout_marginTop="8dp" android:background="@drawable/lv_panel" android:padding="14dp" android:gravity="top|start" android:hint="Viết một câu có sử dụng “Emergency fund”..." android:textColor="@color/lv_text" android:textColorHint="@color/lv_muted" android:textSize="15sp" android:inputType="textMultiLine" android:minLines="2" />
            <LinearLayout android:id="@+id/prompt2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical" android:background="@drawable/lv_panel" android:padding="16dp">
                <TextView android:id="@+id/prompt2Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tình huống 2 · Expenditure" android:textColor="@color/lv_text" android:textSize="15sp" android:layout_marginTop="0dp" android:padding="0dp" android:textStyle="bold" />
                <TextView android:id="@+id/prompt2Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bạn muốn giải thích vì sao gia đình cần cắt giảm một khoản chi tiêu." android:textColor="@color/lv_muted" android:textSize="13sp" android:layout_marginTop="6dp" android:padding="0dp" />
            </LinearLayout>
            <EditText android:id="@+id/sentence2" android:layout_width="match_parent" android:layout_height="94dp" android:layout_marginTop="8dp" android:background="@drawable/lv_panel" android:padding="14dp" android:gravity="top|start" android:hint="Viết một câu có sử dụng “Expenditure”..." android:textColor="@color/lv_text" android:textColorHint="@color/lv_muted" android:textSize="15sp" android:inputType="textMultiLine" android:minLines="2" />
            <LinearLayout android:id="@+id/prompt3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical" android:background="@drawable/lv_panel" android:padding="16dp">
                <TextView android:id="@+id/prompt3Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tình huống 3 · Financial literacy" android:textColor="@color/lv_text" android:textSize="15sp" android:layout_marginTop="0dp" android:padding="0dp" android:textStyle="bold" />
                <TextView android:id="@+id/prompt3Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bạn giải thích vì sao kiến thức tài chính hữu ích cho sinh viên." android:textColor="@color/lv_muted" android:textSize="13sp" android:layout_marginTop="6dp" android:padding="0dp" />
            </LinearLayout>
            <EditText android:id="@+id/sentence3" android:layout_width="match_parent" android:layout_height="94dp" android:layout_marginTop="8dp" android:background="@drawable/lv_panel" android:padding="14dp" android:gravity="top|start" android:hint="Viết một câu có sử dụng “Financial literacy”..." android:textColor="@color/lv_text" android:textColorHint="@color/lv_muted" android:textSize="15sp" android:inputType="textMultiLine" android:minLines="2" />
            <TextView android:id="@+id/warning" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="@color/lv_yellow" android:textSize="13sp" android:layout_marginTop="12dp" android:padding="0dp" />
            <Button android:id="@+id/submit" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="18dp" android:background="@drawable/lv_button" android:backgroundTint="@null" android:text="Nộp bài viết  →" android:textAllCaps="false" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/lv_bg" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>