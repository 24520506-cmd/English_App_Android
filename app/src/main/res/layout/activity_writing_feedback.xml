<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/app_night_bg">
    <com.example.english_app.StarfieldView android:layout_width="match_parent" android:layout_height="match_parent" />
    <ScrollView android:id="@+id/rootScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:id="@+id/contentColumn" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="26dp" android:paddingBottom="44dp">
            <TextView android:id="@+id/back" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="← Quay lại" android:textColor="@color/lv_mint" android:textSize="14sp" android:layout_marginTop="0dp" android:padding="8dp" android:textStyle="bold" />
            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nhận xét bài viết" android:textColor="@color/lv_text" android:textSize="23sp" android:layout_marginTop="22dp" android:padding="0dp" android:textStyle="bold" />
            <TextView android:id="@+id/eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NHẬN XÉT MINH HỌA" android:textColor="@color/lv_yellow" android:textSize="14sp" android:layout_marginTop="9dp" android:padding="0dp" android:textStyle="bold" />
            <TextView android:id="@+id/subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nội dung mẫu; chưa phân tích bài viết của bạn." android:textColor="@color/lv_muted" android:textSize="13sp" android:layout_marginTop="6dp" android:padding="0dp" />
            <LinearLayout android:id="@+id/original" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="vertical" android:background="@drawable/lv_panel" android:padding="16dp">
                <TextView android:id="@+id/originalTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Câu gốc" android:textColor="@color/lv_text" android:textSize="15sp" android:layout_marginTop="0dp" android:padding="0dp" android:textStyle="bold" />
                <TextView android:id="@+id/originalBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="I should create emergency fund." android:textColor="@color/lv_muted" android:textSize="13sp" android:layout_marginTop="6dp" android:padding="0dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/grammar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:background="@drawable/lv_panel" android:padding="16dp">
                <TextView android:id="@+id/grammarTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ngữ pháp &amp; cấu trúc" android:textColor="@color/lv_text" android:textSize="15sp" android:layout_marginTop="0dp" android:padding="0dp" android:textStyle="bold" />
                <TextView android:id="@+id/grammarBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Đề xuất bổ sung mạo từ trong ngữ cảnh phù hợp." android:textColor="@color/lv_muted" android:textSize="13sp" android:layout_marginTop="6dp" android:padding="0dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/usage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:background="@drawable/lv_panel" android:padding="16dp">
                <TextView android:id="@+id/usageTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cách dùng từ mục tiêu" android:textColor="@color/lv_text" android:textSize="15sp" android:layout_marginTop="0dp" android:padding="0dp" android:textStyle="bold" />
                <TextView android:id="@+id/usageBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="“Emergency fund” được dùng đúng hướng; xem gợi ý cải thiện." android:textColor="@color/lv_muted" android:textSize="13sp" android:layout_marginTop="6dp" android:padding="0dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/natural" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:background="@drawable/lv_panel" android:padding="16dp">
                <TextView android:id="@+id/naturalTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Độ tự nhiên" android:textColor="@color/lv_text" android:textSize="15sp" android:layout_marginTop="0dp" android:padding="0dp" android:textStyle="bold" />
                <TextView android:id="@+id/naturalBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cách diễn đạt tự nhiên hơn: I should build an emergency fund." android:textColor="@color/lv_muted" android:textSize="13sp" android:layout_marginTop="6dp" android:padding="0dp" />
            </LinearLayout>
            <Button android:id="@+id/revise" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp" android:background="@drawable/lv_button" android:backgroundTint="@null" android:text="Sửa câu một lần  →" android:textAllCaps="false" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/lv_bg" />
            <Button android:id="@+id/history" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:background="@drawable/lv_button" android:backgroundTint="@null" android:text="Xem lịch sử học" android:textAllCaps="false" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/lv_bg" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>