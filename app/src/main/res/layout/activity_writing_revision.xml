<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/app_night_bg">
    <com.example.english_app.StarfieldView android:layout_width="match_parent" android:layout_height="match_parent" />
    <ScrollView android:id="@+id/rootScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:id="@+id/contentColumn" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="26dp" android:paddingBottom="44dp">
            <TextView android:id="@+id/back" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="← Quay lại" android:textColor="@color/lv_mint" android:textSize="14sp" android:layout_marginTop="0dp" android:padding="8dp" android:textStyle="bold" />
            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sửa bài viết" android:textColor="@color/lv_text" android:textSize="23sp" android:layout_marginTop="22dp" android:padding="0dp" android:textStyle="bold" />
            <TextView android:id="@+id/eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SỬA SAU NHẬN XÉT" android:textColor="@color/lv_yellow" android:textSize="14sp" android:layout_marginTop="9dp" android:padding="0dp" android:textStyle="bold" />
            <TextView android:id="@+id/sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tối đa một lần gửi lại cho mỗi câu." android:textColor="@color/lv_muted" android:textSize="13sp" android:layout_marginTop="6dp" android:padding="0dp" />
            <LinearLayout android:id="@+id/old" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="vertical" android:background="@drawable/lv_panel" android:padding="16dp">
                <TextView android:id="@+id/oldTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bản gốc" android:textColor="@color/lv_text" android:textSize="15sp" android:layout_marginTop="0dp" android:padding="0dp" android:textStyle="bold" />
                <TextView android:id="@+id/oldBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="I should create emergency fund." android:textColor="@color/lv_muted" android:textSize="13sp" android:layout_marginTop="6dp" android:padding="0dp" />
            </LinearLayout>
            <EditText android:id="@+id/revision" android:layout_width="match_parent" android:layout_height="142dp" android:layout_marginTop="14dp" android:background="@drawable/lv_panel" android:padding="14dp" android:gravity="top|start" android:hint="I should build an emergency fund." android:textColor="@color/lv_text" android:textColorHint="@color/lv_muted" android:textSize="15sp" android:inputType="textMultiLine" android:minLines="2" />
            <TextView android:id="@+id/error" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="@color/lv_yellow" android:textSize="13sp" android:layout_marginTop="12dp" android:padding="0dp" />
            <Button android:id="@+id/send" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp" android:background="@drawable/lv_button" android:backgroundTint="@null" android:text="Gửi bản sửa  →" android:textAllCaps="false" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/lv_bg" />
            <Button android:id="@+id/finishStepTwo" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:background="@drawable/lv_button" android:backgroundTint="@null" android:text="Hoàn thành · Về trang chủ" android:textAllCaps="false" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/lv_bg" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
